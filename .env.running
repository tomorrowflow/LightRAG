### API-Key to access LightRAG Server API
### Use this key in HTTP requests with the 'X-API-Key' header
### Example: curl -H "X-API-Key: your-secure-api-key-here" http://localhost:9621/query
LIGHTRAG_API_KEY=RdBy4brXaRbzcb7oteYcpB9crNpPdN2rMhqk2ydZ
WHITELIST_PATHS=/health,/api/*#

# Gunicorn worker timeout (15 minutes)
TIMEOUT=900

# GPU Configuration
CUDA_VISIBLE_DEVICES=0

########################################
### Document processing configuration
########################################
ENABLE_LLM_CACHE_FOR_EXTRACT=true

### Document processing output language: English, Chinese, French, German ...
SUMMARY_LANGUAGE=German

### PDF decryption password for protected PDF files
# PDF_DECRYPT_PASSWORD=your_pdf_password_here

### Entity types that the LLM will attempt to recognize
# ENTITY_TYPES='["Person", "Creature", "Organization", "Location", "Event", "Concept", "Method", "Content", "Data", "Artifact", "NaturalObject", "ActionItem"]'
ENTITY_TYPES='["Person", "Organization", "Team", "StakeholderGroup", "Objective", "KeyResult", "Initiative", "Milestone", "Decision", "DecisionOption", "Constraint", "Risk", "Issue", "Blocker", "TechnicalDebt", "Insight", "Hypothesis", "Experiment", "BestPractice", "Concept", "Meeting", "Communication", "Event", "Document", "Presentation", "Specification", "Capability", "Domain", "Responsibility", "ActionItem", "Status", "Category", "Day", "Week", "Month", "Quarter"]'

RELATIONSHIP_TYPES='["BELONGS_TO", "MEMBER_OF", "PART_OF", "LEADS", "REPORTS_TO", "OWNS", "HAS_CAPABILITY", "RESPONSIBLE_FOR", "CONTRIBUTES_TO", "MEASURES", "DRIVES", "DEPENDS_ON", "CONFLICTS_WITH", "BLOCKS", "THREATENS", "DECIDED_BY", "DECIDED_IN", "CONSIDERS", "CONSTRAINED_BY", "RESULTED_IN", "SUPERSEDES", "INFORMED_BY", "SUPPORTS", "CONTRADICTS", "TESTS", "DERIVED_FROM", "VALIDATES", "RELATES_TO", "APPLIES_TO", "OCCURRED_ON", "CREATED_IN", "DUE_ON", "REVIEWED_IN", "PARTICIPATED_IN", "DISCUSSES", "SENT_BY", "RECEIVED_BY", "REFERENCES", "HAS_STATUS", "STATUS_CHANGED", "TRANSITIONS_TO"]'

### RAGAnything Configuration (Multimodal Document Processing)
### ---
### Parser Configuration
PARSE_METHOD=auto
OUTPUT_DIR=./output
PARSER=mineru
MINERU_DEVICE=cuda:0
DISPLAY_CONTENT_STATS=true

### Multimodal Processing Configuration
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=true

### Batch Processing Configuration
MAX_CONCURRENT_FILES=2
SUPPORTED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.bmp,.tiff,.tif,.gif,.webp,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.md
RECURSIVE_FOLDER_PROCESSING=true

### Context Extraction Configuration
CONTEXT_WINDOW=1
CONTEXT_MODE=page
MAX_CONTEXT_TOKENS=2000
INCLUDE_HEADERS=true
INCLUDE_CAPTIONS=true
CONTEXT_FILTER_CONTENT_TYPES=text
CONTENT_FORMAT=minerU

### Settings for RAG query
HISTORY_TURNS=3
COSINE_THRESHOLD=0.2
TOP_K=60
MAX_TOKEN_TEXT_CHUNK=4000
MAX_TOKEN_RELATION_DESC=4000
MAX_TOKEN_ENTITY_DESC=4000

FORCE_LLM_SUMMARY_ON_MERGE=6
